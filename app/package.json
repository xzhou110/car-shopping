{
  "name": "car-shopping",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local used-car shortlist & compare dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai-tags": "node ../../agent-skills/scripts/image-ai-tags.mjs strip public && node ../../agent-skills/scripts/image-ai-tags.mjs check public",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
